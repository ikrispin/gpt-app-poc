{
  "name": "gpt-app-poc",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && INPUT=mcp-app.html vite build --emptyOutDir false && INPUT=mcp-app-inventory.html vite build --emptyOutDir false && INPUT=mcp-app-creator.html vite build --emptyOutDir false && INPUT=mcp-app-setup.html vite build --emptyOutDir false",
    "serve": "tsx server.ts",
    "test:mcp": "tsx scripts/mcp-smoke-tests.ts",
    "test:unit": "tsx --test --test-concurrency=1 tests/unit/**/*.test.ts",
    "test:contract": "tsx --test --test-concurrency=1 tests/contract/**/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/**/*.test.ts",
    "test:regression": "tsx --test --test-concurrency=1 tests/regression/**/*.test.ts",
    "test:jira": "npm run test:unit && npm run test:contract && npm run test:integration && npm run test:regression"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roddiekieley/gpt-app-poc.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/roddiekieley/gpt-app-poc/issues"
  },
  "homepage": "https://github.com/roddiekieley/gpt-app-poc#readme",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
